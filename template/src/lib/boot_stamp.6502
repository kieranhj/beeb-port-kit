\ ******************************************************************
\ *	boot_stamp.6502 - a !BOOT that says what build it is
\ ******************************************************************
\ *	beeb-port-kit, MIT, Kieran Connell 2026. Baron syntax.
\ *
\ *	WHAT IT IS. Three macros that assemble the disc's !BOOT file with
\ *	the build's own testimony in it: the assembly time from beebasm's
\ *	TIME$, "DEV build" unless RELEASE, one REM per compile flag that is
\ *	on, the version line under RELEASE, then the *RUN. A debug build
\ *	looks like a normal one until the thing you are testing behaves
\ *	oddly; a disc image with no date cannot be matched to a source tree.
\ *	Both ports learned both the hard way, and both now stamp EVERY
\ *	flag that changes what the disc contains (KC's rule), so a build
\ *	cannot lie about itself.
\ *
\ *	WHERE IT CAME FROM.
\ *	  https://github.com/kieranhj/edge-beeb/blob/master/src/main.asm
\ *	    (~1975-2033: one REM per flag, MUSIC_AKL and GFX_CPC stamped
\ *	    OUTSIDE the RELEASE test because they are legal under it)
\ *	  https://github.com/kieranhj/paradroid-beeb/blob/main/src/main.asm
\ *	    (~4500-4591: the DEBUG_ANY fold, ASSERT DEBUG_ANY = 0 under
\ *	    RELEASE, VERSION_LINE in the DEBUG line's seat on a release)
\ *	Edge's shape (a line per flag) is the one here; Paradroid's single
\ *	"REM DEBUG: A B C" line is the same information folded.
\ *
\ *	WHAT WAS MEASURED: nothing electrical. Two facts about the file:
\ *	  - It is a disc file, not code. Edge assembled it inside the code
\ *	    image once and it cost 200 bytes of the tightest region in the
\ *	    build for text nothing executes (its decision 49). Assemble it
\ *	    at a scratch address that exists, that nothing has claimed at
\ *	    assembly time and that it is never loaded to, then put P% back.
\ *	    Paradroid uses &7E00, Edge &2600 (inside its sprite saves).
\ *	  - beebasm's disc option must be 3 (*EXEC), `-opt 3` or the disc
\ *	    builder's equivalent, or the file is never read.
\ *
\ *	THE INCLUDER DEFINES, before this file is included:
\ *	  BOOT_RUN       0 or 1: an *EXEC text !BOOT, or a *RUN stub that
\ *	                 prints the same stamp (below). The template sets it
\ *	                 to RELEASE; it has no default (below says why)
\ *	  RELEASE        0 or 1 (both ports pass it on the command line:
\ *	                 beebasm has no IFDEF and refuses a symbol defined
\ *	                 twice, so main.asm cannot carry a default)
\ *	  BUILD_TIME     the build's timestamp, as a string. BeebASM stamped
\ *	                 this with TIME$; Baron has no TIME$, so the build
\ *	                 script writes it - the template's tools/build_stamp.py
\ *	                 (run by its Makefile and build.ps1) generates
\ *	                 build/build_time.6502 holding one line,
\ *	                 BUILD_TIME = "07 Sep 2026 15:47:31", and main.6502
\ *	                 includes it. NOT a -D: Windows PowerShell cannot
\ *	                 hand a quoted string containing spaces to a native
\ *	                 exe (measured 2026-09-07, three forms). The time is
\ *	                 the SOURCE's (SOURCE_DATE_EPOCH, else the last
\ *	                 commit), so the same commit builds the same disc on
\ *	                 any machine - ../docs/build-portability.md rule 13.
\ *	  DEBUG_ANY      the OR of every DEBUG_ flag; the head macro ASSERTs
\ *	                 it is 0 under RELEASE
\ *	  VERSION_LINE   a string, printed under RELEASE (e.g. "v1.0 2026-09-06")
\ *	and then, at a scratch address:
\ *
\ *	  SECTION Boot, org = BOOT_STAGE,
\ *	          guard = BOOT_STAGE + 256, filename = "!BOOT"
\ *	  .bootfile
\ *	  BOOT_STAMP_HEAD "Edge Grinder"
\ *	  BOOT_FLAG DEBUG_COLL,   "DEBUG_COLL: collisions do not kill"
\ *	  BOOT_FLAG DEBUG_TIMING, "DEBUG_TIMING: the frame meter is running"
\ *	  BOOT_FLAG MUSIC_AKL,    "MUSIC_AKL: Arkos replay"    \ legal under RELEASE
\ *	  BOOT_STAMP_TAIL "Edge"
\ *	  .bootfile_end
\ *	  ENDSECTION      - the filename IS the request to save it, and
\ *	                    the section guard is what the ASSERT was
\ *
\ *	BOOT_FLAG emits its line whenever the flag is non-zero, so a flag
\ *	that is legal under RELEASE (a music or artwork variant) is stamped
\ *	by the same macro; the ASSERT on DEBUG_ANY is what keeps DEBUG_
\ *	flags out of a release, not the stamp. Anything with a "*" prefix,
\ *	such as a bank detector to *RUN first (swram_probe.6502), goes
\ *	between BOOT_FLAG and BOOT_STAMP_TAIL as a plain EQUS.
\ *
\ *	Fork this into your project; keep this header.
\ *	FORKED into beeb-port-kit/template 2026-09-07, unchanged.
\ ******************************************************************

\ ---- BOOT_RUN: a *RUN !BOOT instead of an *EXEC one ----------------
\ BOOT_RUN = 0 (the default if the includer does not define it): !BOOT
\ is the text file above, *EXEC'd, disc option 3.
\ BOOT_RUN = 1: !BOOT is a few bytes of 6502 that PRINT the same lines,
\ without the "REM ", and then OSCLI "RUN <file>" - disc option 2, so
\ the build must pass --opt 2 (the template does for RELEASE). Cleaner
\ on screen, and it needs no language ROM. Two things change for the
\ includer: the section needs exec = its first byte, and it must be
\ assembled where it can RUN - NOT &7E00, which is MODE 7's screen, so
\ printing the stamp would scroll over the code printing it. The
\ template uses &0900. The text must fit 255 bytes (X indexes it).
\ THE INCLUDER DEFINES BOOT_RUN, as it does RELEASE. A default here
\ (IF NOT(DEFINED(BOOT_RUN)) : BOOT_RUN = 0) does not work in Baron: it
\ is undefined on the first pass and defined on the next, so the block
\ flips every pass and the assembly never settles - measured, "did not
\ settle: 'bootfile_end' kept changing" (2026-09-11).

\ ---- REM title [DEV build], REM VERSION_LINE under RELEASE ---------
\ With BOOT_RUN the print loop comes first and the text follows it.
MACRO BOOT_STAMP_HEAD title
IF BOOT_RUN
    ldx #0                      ; (not .print/.text: PRINT is a directive)
.bs_loop
    lda bs_text,x
    beq bs_done
    jsr osasci                  ; 13 goes out as CR and LF
    inx
    bne bs_loop
.bs_done
    txa                         ; the command starts at bs_text + X + 1:
    sec                         ; past the 0 that ended the stamp
    adc #LO(bs_text)
    tax
    lda #HI(bs_text)
    adc #0
    tay
    jmp oscli                   ; RUN <file>: never returns
.bs_text
ENDIF
IF RELEASE
    ASSERT DEBUG_ANY = 0        ; a release carries no debug at all
    IF BOOT_RUN
        EQUS title, 13
        EQUS VERSION_LINE, 13
    ELSE
        EQUS "REM ", title, 13
        EQUS "REM ", VERSION_LINE, 13
    ENDIF
ELSE
    IF BOOT_RUN
        EQUS title, " DEV build", 13
    ELSE
        EQUS "REM ", title, " DEV build", 13
    ENDIF
ENDIF
ENDMACRO

\ ---- one line per flag that is on ---------------------------------
MACRO BOOT_FLAG flag, text
IF flag
    IF BOOT_RUN
        EQUS text, 13
    ELSE
        EQUS "REM ", text, 13
    ENDIF
ENDIF
ENDMACRO

\ ---- BUILD <time>, then RUN <file> --------------------------------
MACRO BOOT_STAMP_TAIL runfile
IF BOOT_RUN
    EQUS "BUILD ", BUILD_TIME, 13, 0
    EQUS "RUN ", runfile, 13    ; OSCLI's command, after the 0
ELSE
    EQUS "REM BUILD ", BUILD_TIME, 13
    EQUS "*RUN ", runfile, 13
ENDIF
ENDMACRO
