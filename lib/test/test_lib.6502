\ ******************************************************************
\ *	test_lib.6502 - proves every file in lib/ assembles together
\ ******************************************************************
\ *	Not a game: dummy hooks, a dummy zero page, every routine and
\ *	every macro instantiated once, both IF branches on. Assemble with
\ *
\ *	  baron -p lib/test/build -D RELEASE=0 lib/test/test_lib.6502
\ *
\ *	from the kit's root (and again with -D RELEASE=1 for the other
\ *	branch of the boot stamp). It writes TEST and BOOT into that
\ *	directory. Baron is silent on success and reports every error in
\ *	one run; check the exit code.
\ ******************************************************************

\ ---- what the includer must define, all of it -------------------
INCLUDE "../beeb.h.6502"

MASTER        = 1               ; loader.6502: load_hazel and unpack_andy
IRQ_UNINSTALL = 1               ; irq.6502: save the MOS's state, uninstall
LOADER_STAGE  = &3000           ; loader.6502: where streams stage
SWR_HAND      = &0A00           ; swram_probe.6502: the five-byte answer
SWR_MAGIC     = &A5
DEBUG_ANY     = 0               ; boot_stamp.6502
BOOT_RUN      = RELEASE         ; boot_stamp.6502: RELEASE=1 assembles the *RUN stub
VERSION_LINE  = "beeb-port-kit lib test"
BUILD_TIME    = "07 Sep 2026 00:00:00"   ; boot_stamp.6502: no TIME$ in Baron
DEBUG_DUMMY   = 1               ; a flag to see one BOOT_FLAG line emitted

\ The depackers' zero-page slots. ZX02 needs all but zxlen; ZX0 needs
\ zxlen too and zxofs as two bytes. A real port instantiates ONE depacker
\ and declares only what that one needs. Baron no longer requires them
\ before the files that use them (zx02depack.6502's header), but they
\ still read better first.
SECTION zeropage, org = &70, guard = &100
.zxsrc  SKIP 2
.zxdst  SKIP 2
.zxofs  SKIP 2
.zxlen  SKIP 2
.zxbit  SKIP 1
.zxwrk  SKIP 2
ENDSECTION

\ ---- the image ------------------------------------------------
SECTION Test, org = &1900, filename = "TEST"
.test_start

\ the two hooks irq.6502 calls
.irq_timer_hook
    CRTC 4, 7                   ; beeb.h.6502's macro, instantiated once
    rts
.irq_vsync_hook
    rts

INCLUDE "../zx02depack.6502"
INCLUDE "../zx0depack.6502"
INCLUDE "../boot_stamp.6502"
INCLUDE "../irq.6502"
INCLUDE "../keydown.6502"
INCLUDE "../loader.6502"

\ zx_unpack is what loader.6502 jumps to: the ZX02 depacker, for a new port.
.zx_unpack
    ZX02_DEPACKER

\ Paradroid instantiated the depacker twice; prove a second copy is legal.
.zx_unpack_again
    ZX02_DEPACKER

\ The ZX0 depacker still assembles beside it, for a port that is a ZX0 disc.
.zx0_unpack
    ZX0_DEPACKER

INCLUDE "../swram_probe.6502"

\ a caller, so every entry point is referenced at least once
.test_main
    ldx #97 : jsr keydown_int
    ldx #&9e : jsr keydown_inkey
    lda #LO(name) : ldy #HI(name) : ldx #4 : jsr load_bank
    lda #LO(name) : ldy #HI(name) : jsr load_hazel
    lda #0 : ldx #&80 : jsr unpack_andy
    jsr install_irq
    jsr uninstall_irq
    jsr SwrMain
    rts
.name EQUS "Bank0", 13

.test_end
ENDSECTION

\ ---- !BOOT, at a scratch address --------------------------------
BOOT_STAGE = &7E00
SECTION Boot, org = BOOT_STAGE, guard = BOOT_STAGE + 256, filename = "BOOT"
.bootfile
    BOOT_STAMP_HEAD "Lib test"
    BOOT_FLAG DEBUG_DUMMY, "DEBUG_DUMMY: a flag that is on"
    BOOT_FLAG DEBUG_ANY,   "never printed"
    EQUS "*RUN PARSWR", 13
    BOOT_STAMP_TAIL "Game"
.bootfile_end
ENDSECTION                      \ written as BOOT, to read the stamp back

PRINT "test image ", ~test_start, "-", ~test_end, " (", test_end - test_start, " bytes)"
PRINT "!BOOT ", bootfile_end - bootfile, " bytes"
